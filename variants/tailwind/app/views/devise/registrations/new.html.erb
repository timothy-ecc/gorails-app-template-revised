<div class="mx-auto mt-10 w-full max-w-sm">
  <h1 class="mb-6 text-center text-2xl font-bold text-gray-900">Sign Up</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="mb-4">
      <%= f.text_field :name, autofocus: false, class: 'block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 shadow-sm placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 sm:text-sm', placeholder: "Full name" %>
    </div>

    <div class="mb-4">
      <%= f.email_field :email, autofocus: false, class: 'block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 shadow-sm placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 sm:text-sm', placeholder: "Email Address" %>
    </div>

    <div class="mb-4">
      <%= f.password_field :password, autocomplete: "off", class: 'block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 shadow-sm placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 sm:text-sm', placeholder: 'Password' %>
    </div>

    <div class="mb-4">
      <%= f.password_field :password_confirmation, autocomplete: "off", class: 'block w-full rounded-md border border-gray-300 px-3 py-2 text-gray-900 shadow-sm placeholder-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 sm:text-sm', placeholder: 'Confirm Password' %>
    </div>

    <div class="mb-4">
      <%= f.submit "Sign up", class: "inline-flex w-full justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2" %>
    </div>
  <% end %>

  <div class="text-center text-sm text-gray-600">
    <%= render "devise/shared/links" %>
  </div>
</div>
