<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold text-gray-900"><%= human_name %></h1>

  <div class="flex items-center gap-2">
  <%%= link_to <%= index_helper %>_path, class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50" do %>
    All <%= plural_table_name.capitalize %>
  <%% end %>
  <%%= link_to edit_<%= singular_table_name %>_path(@<%= singular_table_name %>), class: "inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" do %>
    Edit
  <%% end %>
  </div>
</div>

<dl class="divide-y divide-gray-100 rounded-md border border-gray-200">
<%- attributes.each do |attribute| -%>
  <div class="flex gap-4 px-4 py-3 text-sm">
    <dt class="w-40 shrink-0 font-medium text-gray-500"><%= attribute.human_name %>:</dt>
    <dd><%%= @<%= singular_table_name %>.<%= attribute.name %> %></dd>
  </div>
<%- end -%>
</dl>
